rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health probe: read-only access for connection checks
    match /_health_check/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Strict Tenant Isolation: users can only read/write documents scoped to their verified schoolId
    match /schools/{schoolId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.schoolId == schoolId;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
