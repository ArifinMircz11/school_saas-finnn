rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read-only access for health diagnostics probe
    match /_health_check/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Secure all application data: require authenticated user
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
