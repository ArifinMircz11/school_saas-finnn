# Server
PORT=5000
NODE_ENV=development
CLIENT_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5178

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_saas

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ISSUER=school-management-saas
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cloudinary / object storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=school-saas

# Public base URLs (used for generated artifact links)
STORAGE_BASE_URL=https://storage.local
REPORTS_BASE_URL=https://reports.local
CERTIFICATES_BASE_URL=https://certificates.local

# Email (REST API) - Resend primary, Brevo fallback. Leave both empty for the dev stub.
EMAIL_FROM=noreply@schoosaas.com
RESEND_API_KEY=
RESEND_FROM=
RESEND_BASE_URL=https://api.resend.com
BREVO_API_KEY=
BREVO_FROM=
BREVO_FROM_NAME=School SaaS
BREVO_BASE_URL=https://api.brevo.com

# Legacy SMTP (optional - Resend/Brevo preferred)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yoursaas.com