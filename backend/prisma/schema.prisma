generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ CORE IDENTITY & TENANCY ============

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  PARENT
  STUDENT
  STAFF
}

model School {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  domain          String?  @unique
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  country         String   @default("IN")
  logoUrl         String?
  status          String   @default("PENDING")
  planId          String?
  plan            SubscriptionPlan?  @relation(fields: [planId], references: [id])
  maxStudents     Int      @default(1000)
  maxTeachers     Int      @default(100)
  maxAdmins       Int      @default(5)
  maxStorageMb    Int      @default(10240)
  enabledModules  Json     @default("{}")
  settings        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  users           User[]
  students        Student[]
  teachers        Teacher[]
  parents         Parent[]
  staff           Staff[]
  sessions        AcademicSession[]
  classes         Class[]
  sections        Section[]
  subjects        Subject[]
  admissions      Admission[]
  feeCategories   FeeCategory[]
  feeStructures   FeeStructure[]
  studentFees     StudentFee[]
  feePayments     FeePayment[]
  subscriptions   SchoolSubscription[]
  exams           Exam[]
  timetables      Timetable[]
  notices         Notice[]
  certificates    Certificate[]
  attendance      Attendance[]
  homework        Homework[]
  examResults     ExamResult[]
  notifications   Notification[]
  studentDocuments StudentDocument[]
  invoices        Invoice[]
  supportTickets  SupportTicket[]
  auditLogs       AuditLog[]
  principalProfiles PrincipalProfile[]
  approvalRequests  ApprovalRequest[]

  @@index([status])
  @@index([planId])
}

model User {
  id            String    @id @default(cuid())
  schoolId      String?
  school        School?   @relation(fields: [schoolId], references: [id])
  email         String    @unique
  firstName     String
  lastName      String
  phone         String?
  passwordHash  String
  avatarUrl     String?
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles           UserRoleAssignment[]
  permissions     UserPermission[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  teacher         Teacher?
  student         Student?
  parent          Parent?
  staff           Staff?
  principal       PrincipalProfile?
  notifications   Notification[]
  @@index([schoolId])
  @@index([deletedAt])
}

model UserRoleAssignment {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  role      UserRole
  assignedBy String?

  @@unique([userId, role])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String?
  userPermissions UserPermission[]
}

model UserPermission {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  permissionId String
  permission Permission @relation(fields: [permissionId], references: [id])
  granted    Boolean    @default(true)

  @@unique([userId, permissionId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  @@index([userId, expiresAt])
}

model EmailOtp {
  id         String   @id @default(cuid())
  email      String   @unique
  code       String
  purpose    String   @default("EMAIL_VERIFICATION")
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}
// ------------ ACADEMIC ------------
model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  exams     Exam[]
}

model Class {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  sections  Section[]
  students  Student[]
  admissions Admission[]
  createdAt DateTime @default(now())
  @@unique([schoolId, name])
}

model Section {
  id         String @id @default(cuid())
  schoolId   String
  school     School @relation(fields: [schoolId], references: [id])
  classId    String
  class      Class  @relation(fields: [classId], references: [id])
  name       String
  students   Student[]
  teachers   TeacherSection[]
  timetables Timetable[]
  homework   Homework[]
  @@unique([classId, name])
}

model Subject {
  id         String @id @default(cuid())
  schoolId   String
  school     School @relation(fields: [schoolId], references: [id])
  name       String
  code       String?
  teachers   TeacherSubject[]
  exams      ExamSubject[]
  timetables Timetable[]
  homework   Homework[]
  @@unique([schoolId, name])
}

// ------------ PEOPLE ------------
model Student {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  admissionNo String   @unique
  rollNo      Int?
  firstName   String
  lastName    String
  gender      String
  dob         DateTime
  photoUrl    String?
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  sectionId   String?
  section     Section? @relation(fields: [sectionId], references: [id])
  bloodGroup  String?
  address     String?
  enrollmentDate DateTime @default(now())
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parents     StudentParent[]
  fees        StudentFee[]
  attendance  Attendance[]
  submissions HomeworkSubmission[]
  results     ExamResult[]
  documents   StudentDocument[]
  certificates Certificate[]
  @@index([schoolId, classId])
}

model Parent {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id])
  firstName  String
  lastName   String
  phone      String?
  occupation String?
  children   StudentParent[]
  createdAt  DateTime @default(now())
}

model StudentParent {
  id           String @id @default(cuid())
  studentId    String
  student      Student @relation(fields: [studentId], references: [id])
  parentId     String
  parent       Parent  @relation(fields: [parentId], references: [id])
  relationship String @default("PARENT")
  isPrimary    Boolean @default(false)
  @@unique([studentId, parentId])
}

model Teacher {
  id          String @id @default(cuid())
  schoolId    String
  school      School @relation(fields: [schoolId], references: [id])
  userId      String? @unique
  user        User?  @relation(fields: [userId], references: [id])
  empCode     String @unique
  firstName   String
  lastName    String
  phone       String?
  photoUrl    String?
  designation String?
  sections    TeacherSection[]
  subjects    TeacherSubject[]
  homework    Homework[]
  marks       ExamResult[]
  timetables  Timetable[]
  createdAt   DateTime @default(now())
}

model TeacherSection {
  id        String @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])
  @@unique([teacherId, sectionId])
}

model TeacherSubject {
  id        String @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  @@unique([teacherId, subjectId])
}

model Staff {
  id        String @id @default(cuid())
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id])
  userId    String? @unique
  user      User?  @relation(fields: [userId], references: [id])
  empCode   String @unique
  firstName String
  lastName  String
  role      String
  createdAt DateTime @default(now())
}
// ------------ ADMISSIONS ------------
model Admission {
  id            String      @id @default(cuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id])
  applicationNo String      @unique
  firstName     String
  lastName      String
  dob           DateTime?
  gender        String?
  classId       String?
  class         Class?      @relation(fields: [classId], references: [id])
  parentName    String?
  parentEmail   String?
  parentPhone   String?
  status        String      @default("PENDING")
  documents     AdmissionDocument[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@index([schoolId, status])
}

model AdmissionDocument {
  id          String @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id])
  type        String
  url         String
  verified    Boolean @default(false)
  createdAt   DateTime @default(now())
}

// ------------ FEES ------------
model FeeCategory {
  id          String @id @default(cuid())
  schoolId    String
  school      School @relation(fields: [schoolId], references: [id])
  name        String
  description String?
  frequency   String @default("YEARLY")
  createdAt   DateTime @default(now())
  structures  FeeStructure[]
  @@unique([schoolId, name])
}

model FeeStructure {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  name       String
  categoryId String?
  category   FeeCategory? @relation(fields: [categoryId], references: [id])
  amount     Decimal
  dueDate    DateTime?
  lateFee    Decimal   @default(0)
  discount   Decimal   @default(0)
  installment Int      @default(1)
  createdAt  DateTime  @default(now())
  students   StudentFee[]
}

model StudentFee {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  structureId String
  structure   FeeStructure @relation(fields: [structureId], references: [id])
  totalAmount Decimal
  paidAmount  Decimal   @default(0)
  discount    Decimal   @default(0)
  status      String    @default("PENDING")
  dueDate     DateTime?
  payments    FeePayment[]
  createdAt   DateTime  @default(now())
  @@index([schoolId, status])
}

model FeePayment {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])
  studentFeeId String
  studentFee   StudentFee @relation(fields: [studentFeeId], references: [id])
  amount       Decimal
  method       String     @default("CASH")
  transactionId String?
  status       String     @default("SUCCESS")
  collectedBy  String?
  paidAt       DateTime   @default(now())
  receiptNo    String?
  @@index([schoolId, paidAt])
}

// ------------ ATTENDANCE ------------
model Attendance {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  date      DateTime
  status    String   @default("PRESENT")
  markedBy  String?
  remarks   String?
  createdAt DateTime @default(now())
  @@unique([studentId, date])
  @@index([schoolId, date, studentId])
}

// ------------ HOMEWORK ------------
model Homework {
  id            String             @id @default(cuid())
  schoolId      String
  school        School             @relation(fields: [schoolId], references: [id])
  teacherId     String
  teacher       Teacher            @relation(fields: [teacherId], references: [id])
  sectionId     String?
  section       Section?           @relation(fields: [sectionId], references: [id])
  subjectId     String
  subject       Subject            @relation(fields: [subjectId], references: [id])
  title         String
  description   String?
  attachmentUrl String?
  dueDate       DateTime
  published     Boolean            @default(true)
  submissions   HomeworkSubmission[]
  createdAt     DateTime           @default(now())
  @@index([schoolId, sectionId])
}

model HomeworkSubmission {
  id            String    @id @default(cuid())
  homeworkId    String
  homework      Homework  @relation(fields: [homeworkId], references: [id])
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  content       String?
  attachmentUrl String?
  submittedAt   DateTime  @default(now())
  marks         Int?
  feedback      String?
  @@unique([homeworkId, studentId])
}

// ------------ EXAMS ------------
model Exam {
  id        String          @id @default(cuid())
  schoolId  String
  school    School          @relation(fields: [schoolId], references: [id])
  name      String
  sessionId String?
  session   AcademicSession? @relation(fields: [sessionId], references: [id])
  startDate DateTime
  endDate   DateTime
  subjects  ExamSubject[]
  results   ExamResult[]
  createdAt DateTime        @default(now())
  @@index([schoolId, startDate])
}

model ExamSubject {
  id        String     @id @default(cuid())
  examId    String
  exam      Exam       @relation(fields: [examId], references: [id])
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id])
  maxMarks  Int
  passMarks Int
  date      DateTime?
  results   ExamResult[]
  @@unique([examId, subjectId])
}

model ExamResult {
  id            String     @id @default(cuid())
  schoolId      String
  school        School     @relation(fields: [schoolId], references: [id])
  examId        String
  exam          Exam       @relation(fields: [examId], references: [id])
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id])
  studentId     String
  student       Student    @relation(fields: [studentId], references: [id])
  teacherId     String?
  teacher       Teacher?   @relation(fields: [teacherId], references: [id])
  marksObtained Decimal
  enteredBy     String?
  published     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  @@unique([examSubjectId, studentId])
  @@index([schoolId, examId])
  @@index([schoolId, studentId])
}

// ------------ TIMETABLE ------------
model Timetable {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  day       String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  @@index([schoolId, day])
}
model Notice {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  title     String
  content   String
  audience  String   @default("ALL")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   @default("GENERAL")
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([schoolId, userId, read])
  @@index([createdAt])
}

// ------------ DOCUMENTS & CERTIFICATES ------------
model StudentDocument {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  type       String
  title      String
  url        String
  mimeType   String?
  size       Int?
  verified   Boolean  @default(false)
  uploadedBy String
  createdAt  DateTime @default(now())
  @@index([schoolId, studentId])
}

model Certificate {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  type      String
  number    String   @unique
  pdfUrl    String?
  issuedAt  DateTime @default(now())
  createdBy String
  @@index([schoolId, studentId])
}
// ------------ SUBSCRIPTIONS ------------
model SubscriptionPlan {
  id           String @id @default(cuid())
  name         String
  code         String @unique
  price        Decimal
  period       String @default("MONTHLY")
  maxStudents  Int
  maxTeachers  Int
  maxAdmins    Int
  maxStorage   Int
  modules      Json   @default("{}")
  isActive     Boolean @default(true)
  schools      School[]
  subscriptions SchoolSubscription[]
  createdAt    DateTime @default(now())
}

model SchoolSubscription {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  planId     String
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])
  startDate  DateTime
  endDate    DateTime
  status     String   @default("TRIAL")
  trialEnds  DateTime?
  invoices   Invoice[]
  createdAt  DateTime @default(now())
}

model Invoice {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  subscriptionId String
  subscription   SchoolSubscription @relation(fields: [subscriptionId], references: [id])
  amount         Decimal
  status         String   @default("PENDING")
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime @default(now())
}

// ------------ AUDIT & SUPPORT ------------
model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  details   Json?
  ip        String?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id           String   @id @default(cuid())
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id])
  userId       String
  subject      String
  description  String
  status       String   @default("OPEN")
  priority     String   @default("MEDIUM")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ------------ PRINCIPAL ------------
// A Principal belongs to a single school; created by the School Admin.
model PrincipalProfile {
  id                String   @id @default(cuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id])
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  title             String?
  approvalWorkflow  Boolean  @default(true) // admission requires principal approval when true
  createdAt         DateTime @default(now())
}

// Centralized approval center used by the Principal (and optionally School Admin).
// Types: TEACHER_LEAVE, STAFF_LEAVE, STUDENT_LEAVE, ADMISSION, RESULT_PUBLISH,
//        CERTIFICATE, TC, OTHER. Every decision is recorded in the audit log.
model ApprovalRequest {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  type        String   @default("OTHER")
  referenceId String?
  reference   String?
  title       String
  description String?
  requestedBy String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, CHANGES_REQUESTED
  comment     String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, status])
}