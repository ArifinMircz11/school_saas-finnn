{
  "compilerOptions": {
    "target": "ES2020", "useDefineForClassFields": true, "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true, "isolatedModules": true,
    "noEmit": true, "baseUrl": ".", "paths": { "@shared/*": ["../shared/src/*"] }, "types": ["vite/client"]
  },
  "include": ["src", "../shared/src"]
}