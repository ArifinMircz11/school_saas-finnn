{
  "compilerOptions": {
    "target": "ES2020", "useDefineForClassFields": true, "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true, "isolatedModules": true,
    "noEmit": true, "baseUrl": ".",
    "paths": {
      "@saas/api-client": ["../packages/api-client/src/index.ts"],
      "@saas/shared-ui": ["../packages/shared-ui/src/index.ts"],
      "@saas/shared-ui/styles.css": ["../packages/shared-ui/src/system.css"]
    },
    "types": ["vite/client"]
  },
  "include": ["src"]
}