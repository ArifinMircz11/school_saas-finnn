# Use a dedicated Firebase project or a dedicated non-default Firestore database.
# Do not copy production credentials into this file or commit a real .env.
FIREBASE_NEXT_PROJECT_ID=your-new-firebase-project-id
FIREBASE_NEXT_DATABASE_ID=your-new-firestore-database-id
FIREBASE_NEXT_PORT=5100
FIREBASE_NEXT_CLIENT_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5178

# Authenticate the server with Application Default Credentials.
# Local development: gcloud auth application-default login
# Production: attach a least-privilege service account to the runtime.
# Do not commit service-account JSON keys.